version: '3.8'

services:
  postgres:
    image: pgvector/pgvector:pg15-latest
    container_name: codebase_postgres
    environment:
      POSTGRES_PASSWORD: ${DB_PASSWORD:-postgres}
      POSTGRES_DB: codebase_ai
    volumes:
      - postgres_data:/var/lib/postgresql/data
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  redis:
    image: redis:7-alpine
    container_name: codebase_redis
    command: redis-server --requirepass ${REDIS_PASSWORD:-redis} --appendonly yes
    volumes:
      - redis_data:/data
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5
    restart: unless-stopped

  api-gateway:
    build:
      context: ./api-gateway
      dockerfile: Dockerfile
    container_name: codebase_api
    environment:
      # Database (use RDS/Supabase in production)
      DATABASE_URL: ${DATABASE_URL:-postgresql://postgres:postgres@postgres:5432/codebase_ai}
      
      # Redis (use Upstash in production)
      REDIS_URL: ${REDIS_URL:-redis://localhost:6379}
      
      # Auth
      JWT_SECRET: ${JWT_SECRET}
      GITHUB_CLIENT_ID: ${GITHUB_CLIENT_ID}
      GITHUB_CLIENT_SECRET: ${GITHUB_CLIENT_SECRET}
      GITHUB_CALLBACK_URL: ${GITHUB_CALLBACK_URL}
      
      # LLM
      GROQ_API_KEY: ${GROQ_API_KEY}
      
      # App
      NODE_ENV: production
      LOG_LEVEL: info
      PORT: 3000
    ports:
      - "3000:3000"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

  ingestion-worker:
    build:
      context: ./ingestion-worker
      dockerfile: Dockerfile
    container_name: codebase_worker
    environment:
      # Database
      DATABASE_URL: ${DATABASE_URL:-postgresql://postgres:postgres@postgres:5432/codebase_ai}
      
      # Redis
      REDIS_URL: ${REDIS_URL:-redis://localhost:6379}
      
      # HuggingFace Embeddings
      HF_MODEL_NAME: BAAI/bge-small-en-v1.5
      
      # LLM
      GROQ_API_KEY: ${GROQ_API_KEY}
      
      # Celery
      CELERY_BROKER_URL: ${REDIS_URL:-redis://localhost:6379/0}
      CELERY_RESULT_BACKEND: ${REDIS_URL:-redis://localhost:6379/1}
      
      # Logging
      LOG_LEVEL: info
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    restart: unless-stopped
    logging:
      driver: "json-file"
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  postgres_data:
  redis_data:

networks:
  default:
    name: codebase_backend