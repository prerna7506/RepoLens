{
  "buildCommand": "cd frontend && npm run build -- --configuration production",
  "outputDirectory": "frontend/dist/frontend/browser",
  "installCommand": "cd frontend && npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://repolens-web.onrender.com/api/$1"
    },
    {
      "source": "/auth/github",
      "destination": "https://repolens-web.onrender.com/auth/github"
    },
    {
      "source": "/auth/github/callback",
      "destination": "https://repolens-web.onrender.com/auth/github/callback"
    },
    {
      "source": "/auth/refresh",
      "destination": "https://repolens-web.onrender.com/auth/refresh"
    },
    {
      "source": "/auth/logout",
      "destination": "https://repolens-web.onrender.com/auth/logout"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}