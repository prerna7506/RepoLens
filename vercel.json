{
  "buildCommand": "cd frontend && npm run build -- --configuration production",
  "outputDirectory": "frontend/dist/frontend/browser",
  "installCommand": "npm install && cd frontend && npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://<RENDER_API_URL>/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://<RENDER_API_URL>/auth/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}