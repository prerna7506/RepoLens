# ============ Database ============
DB_PASSWORD=your_secure_db_password
DATABASE_URL=postgresql://postgres:your_secure_db_password@db.your-domain.com:5432/codebase_ai

# ============ Cache (Redis) ============
REDIS_PASSWORD=your_secure_redis_password
REDIS_URL=redis://:your_secure_redis_password@cache.your-domain.com:6379

# ============ Authentication ============
JWT_SECRET=your-256-bit-secret-key-generated-with-openssl
GITHUB_CLIENT_ID=github_app_client_id
GITHUB_CLIENT_SECRET=github_app_client_secret
GITHUB_CALLBACK_URL=https://api.yourdomain.com/auth/github/callback

# ============ LLM Provider ============
GROQ_API_KEY=gsk-production-groq-key

# ============ Server Config ============
NODE_ENV=production
LOG_LEVEL=info
PORT=3000